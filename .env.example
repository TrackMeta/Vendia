# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube a GitHub.

# Supabase → Project Settings → API (o "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública: "Publishable key" (sb_publishable_...) o la antigua "anon public"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave SECRETA, solo servidor: "Secret key" (sb_secret_...) o la antigua "service_role"
SUPABASE_SECRET_KEY=

# Conexión directa a la base de datos (solo para crear tablas/migraciones desde tu PC).
# Supabase → botón "Connect" → "Session pooler" → URI. Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos.
SUPABASE_DB_URL=
